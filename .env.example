# Пример окружения add-on'а для `docker compose` (см. docker-compose.yml).
# Скопируйте в `.env` (вне git) и заполните значения. Пустая строка = значение
# не задано. Полный справочник — docs/configuration.md.

# Bearer-токен API. Без него аутентификация отключена (локальный запуск).
SYNTH_ADDON_TOKEN=
# URL egress-прокси: http(s):// (CONNECT) или socks5:// (пусто — прямые запросы).
SYNTH_ADDON_PROXY_URL=
